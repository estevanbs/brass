{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/infrastructure",
    "tsBuildInfoFile": "../../dist/out-tsc/infrastructure.tsbuildinfo",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test-setup.ts"
  ],
  "references": [
    {
      "path": "../backend-application/tsconfig.lib.json"
    },
    {
      "path": "../backend-domain/tsconfig.lib.json"
    },
    {
      "path": "../application/tsconfig.lib.json"
    },
    {
      "path": "../domain/tsconfig.lib.json"
    }
  ]
}
